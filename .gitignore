# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
.next/
dist/
build/
out/

# Environment files — ignore secrets, keep examples
.env
.env.local
.env.*.local
.env.production
!.env.example
# .env.backup was tracked. Its values turned out to be placeholders — Razorpay,
# R2 and SMTP blank, Gemini a literal "your..." — so it was not a leak. It is
# the shape of an accident rather than one, and the name is now excluded so the
# next copy of a working .env cannot be committed by the same route.
.env.backup
.env.bak
.env.save
.env.*.backup

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/
htmlcov/
.coverage

# Turbo
.turbo/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/

# Local media storage — written by LocalStorage in dev and tests
apps/api/media_store/
media_store/

# Redis snapshot — written into whatever directory redis-server is started from.
# It is a local dev artifact and was committed once by accident.
dump.rdb

# YOLOv8 weights, downloaded by the safety-detection tests at run time.
# 6.3 MB of binary that regenerates itself; it landed in a commit once.
*.pt

# Local SQLite databases — a dev server or test run drops these in apps/api.
# Nothing tracked has ever been a .db, and committing one would put a snapshot
# of local data into the repo (the same trap as the 6.3MB model weights).
*.db
!Thumbs.db
