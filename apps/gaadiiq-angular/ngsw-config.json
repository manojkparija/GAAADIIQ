{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/favicon.svg",
          "/apple-touch-icon.png",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/media/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-catalogue",
      "urls": [
        "https://api.gaadiiq.com/cars/**",
        "https://gaadiiq-api.onrender.com/cars/**",
        "https://api.gaadiiq.com/listings/**",
        "https://gaadiiq-api.onrender.com/listings/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 100,
        "maxAge": "10m",
        "timeout": "5s"
      }
    },
    {
      "name": "api-static",
      "urls": [
        "https://api.gaadiiq.com/health",
        "https://gaadiiq-api.onrender.com/health",
        "https://api.gaadiiq.com/loans/bank-rates",
        "https://gaadiiq-api.onrender.com/loans/bank-rates"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 20,
        "maxAge": "1h"
      }
    }
  ]
}
