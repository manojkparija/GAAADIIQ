<?xml version="1.0" encoding="utf-8"?>
<!--
  The plate behind the adaptive icon's foreground layer.

  Was #FFFFFF, the Capacitor default. The brand mark is drawn for a light
  surface and reads as a white square among coloured icons in a launcher, so
  the app looked unfinished next to everything else on a home screen.

  This is the value of the `navy` custom property in styles.scss, the app's own
  page background, so the icon shares a surface with the product rather than a
  colour chosen only here.

  (Written without a double hyphen anywhere: XML forbids that sequence inside a
  comment, and naming the CSS variable in its usual form failed the Android
  resource merger with "The string is not permitted within comments".)
-->
<resources>
    <color name="ic_launcher_background">#F4F7FB</color>
</resources>
