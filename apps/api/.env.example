APP_NAME=GAADIIQ API
DEBUG=false
ENVIRONMENT=production

# PostgreSQL (Supabase)
DATABASE_URL=postgresql+asyncpg://user:password@db.supabase.co:5432/gaadiiq

# Redis (Oracle Cloud)
REDIS_URL=redis://localhost:6379

# JWT — RS256 asymmetric keypair (generate with: openssl genrsa 2048 | tee private.pem; openssl rsa -in private.pem -pubout -out public.pem)
# Paste PEM strings with literal \n newlines, e.g.:
#   JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS — add your Capacitor/Android scheme and prod domain
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:4200","capacitor://localhost","https://gaadiiq.com","https://www.gaadiiq.com"]

# Cloudflare R2 (get from Cloudflare dashboard → R2 → API Tokens)
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=gaadiiq-media
R2_PUBLIC_URL=https://media.gaadiiq.com

# AI / Ollama (self-hosted on Oracle Cloud Free Tier)
# Install: curl https://ollama.ai/install.sh | sh && ollama pull llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_DIAGNOSIS_MODEL=llama3
OLLAMA_VISION_MODEL=llava
VALUATION_MODEL=llama3
VALUATION_TIMEOUT_SECONDS=30

# Razorpay (leave blank → dev auto-approve; required in production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Qdrant vector database
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=gaadiiq_listings

# n8n workflow automation
N8N_WEBHOOK_URL=
N8N_SECRET=

# Frontend URL (used in password-reset emails)
FRONTEND_URL=https://gaadiiq.com

# SMTP (leave blank to skip emails in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@gaadiiq.com
