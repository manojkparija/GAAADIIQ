# GAADIIQ API Configuration
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Replace the placeholder values with your actual configuration
# 3. Keep SUPABASE_JWT_SECRET and other secrets PRIVATE - never commit .env

# ============================================================================
# DATABASE - SQLite for Development, PostgreSQL for Production
# ============================================================================
# For development: Use SQLite (local, no network required)
# For production: Use Supabase PostgreSQL
# Note: Alembic migrations skip for SQLite, using direct schema creation instead
DATABASE_URL=sqlite+aiosqlite:///./gaadiiq_dev.db

# ============================================================================
# REDIS - Local cache
# ============================================================================
REDIS_URL=redis://localhost:6379

# ============================================================================
# JWT - Authentication (RS256)
# ============================================================================
# In production, use actual PEM keys. For development, they're auto-generated
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ============================================================================
# ENVIRONMENT
# ============================================================================
ENVIRONMENT=development
DEBUG=true
APP_NAME=GAADIIQ API
APP_VERSION=0.1.0

# ============================================================================
# AI / VISION PROVIDERS
# ============================================================================
# Gemini (primary vision provider for brochure ingestion)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-3.5-flash-lite

# Ollama (local vision fallback) - set to false to skip
OLLAMA_VISION=false
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================================
# CORS - Frontend URLs
# ============================================================================
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:4200","https://localhost:4200"]

# ============================================================================
# STORAGE - Cloudflare R2 (S3-compatible)
# ============================================================================
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=gaadiiq-media
R2_PUBLIC_URL=https://media.gaadiiq.com

# ============================================================================
# MEDIA - Upload Size Limits
# ============================================================================
# Maximum file size for admin image uploads (in megabytes)
# Default: 100 MB (suitable for high-quality photography)
# Note: Files >100 MB require chunked/resumable upload (WAVE 3 feature)
# Adjust based on your infrastructure: smaller for bandwidth-constrained,
# larger for high-volume production use (but requires scaling considerations)
MEDIA_MAX_UPLOAD_MB=100

# ============================================================================
# EMAIL - SMTP Configuration
# ============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@gaadiiq.com

# ============================================================================
# PAYMENTS - Razorpay
# ============================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ============================================================================
# ADMIN - Super admin email addresses
# ============================================================================
ADMIN_EMAILS=your-email@example.com

# ============================================================================
# SUPABASE - JWT Verification
# ============================================================================
# Get this from: Supabase Project → Settings → JWT Keys → Legacy JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
SUPABASE_URL=https://your-project.supabase.co

# ============================================================================
# FRONTEND - URL for password reset links
# ============================================================================
FRONTEND_URL=http://localhost:3000

# ============================================================================
# WAVE 3 - ML Features (Semantic Search, OCR, Safety Detection)
# ============================================================================
# CLIP Embeddings (text-to-image semantic search)
CLIP_MODEL_NAME=sentence-transformers/clip-vit-b-32
CLIP_BATCH_SIZE=32
ENABLE_EMBEDDINGS=true

# Tesseract OCR (brochure text extraction)
TESSERACT_TIMEOUT_SECONDS=30
ENABLE_OCR=true

# Safety Detection (NSFW + License Plate Detection)
YOLOV8_MODEL_NAME=yolov8n.pt
NSFW_THRESHOLD=0.5
LICENSE_PLATE_CONFIDENCE_THRESHOLD=0.5
ENABLE_SAFETY_DETECTION=true

# Qdrant Vector Database (for semantic search storage)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=gaadiiq_listings
QDRANT_API_KEY=
